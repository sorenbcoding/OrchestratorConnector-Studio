{
  "name": "sorenb-studio-tenant-switcher",
  "displayName": "Tenant Switcher for UiPath Studio",
  "description": "Switches the local Studio and Robot between Orchestrator tenants using saved presets with machine client credentials.",
  "version": "0.3.0",
  "publisher": "sorenbcoding",
  "license": "MIT",
  "author": "Søren Schytz Birk",
  "homepage": "https://github.com/sorenbcoding/tenant-switcher-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorenbcoding/tenant-switcher-studio"
  },
  "bugs": {
    "url": "https://github.com/sorenbcoding/tenant-switcher-studio/issues"
  },
  "icon": "branding/tenant-switcher-studio-light-128.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "os": [
    "win32"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "uipath",
    "orchestrator",
    "studio",
    "tenant",
    "robot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tenantSwitcher",
          "title": "Tenant Switcher",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tenantSwitcher": [
        {
          "type": "webview",
          "id": "tenantSwitcher.panel",
          "name": "Presets"
        }
      ]
    },
    "commands": [
      {
        "command": "tenantSwitcher.addPreset",
        "title": "Add preset",
        "category": "Tenant Switcher"
      },
      {
        "command": "tenantSwitcher.pickPreset",
        "title": "Switch tenant…",
        "category": "Tenant Switcher"
      }
    ],
    "configuration": {
      "title": "Tenant Switcher",
      "properties": {
        "tenantSwitcher.uiRobotPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to `UiRobot.exe`. Leave empty to auto-detect.",
          "scope": "machine"
        },
        "tenantSwitcher.restartAssistant": {
          "type": "boolean",
          "default": true,
          "description": "Close UiPath Assistant before switching and start it again afterwards.",
          "scope": "machine"
        },
        "tenantSwitcher.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before switching tenant."
        },
        "tenantSwitcher.validateBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Request a token with the preset's client credentials before disconnecting, so bad credentials never leave the Robot disconnected."
        },
        "tenantSwitcher.uipCliPath": {
          "type": "string",
          "default": "uip",
          "markdownDescription": "Command or full path for the UiPath CLI (`uip`), used when a preset has *Sync uip CLI* enabled.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
